<?xml version="1.0" encoding="utf-8"?>
<!--
  kotlinBackend API 33+ (Android 13) themable launcher icon. The color
  layers keep the badged foreground (see the v26 override); the monochrome
  layer is the single-color mesh + WIP-wrench silhouette that launchers use
  to recolor the icon to the user's theme/wallpaper color.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground_kt"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome_kt"/>
</adaptive-icon>
