            android:pathData="M406.658,182.257 m-16,0 a16,16 0,1 1,32 0 a16,16 0,1 1,-32 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M356.658,138.257 m-18,0 a18,18 0,1 1,36 0 a18,18 0,1 1,-36 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M270.658,193.257 m-13,0 a13,13 0,1 1,26 0 a13,13 0,1 1,-26 0"
