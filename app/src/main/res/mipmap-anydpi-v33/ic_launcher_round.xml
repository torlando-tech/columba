<?xml version="1.0" encoding="utf-8"?>
<!--
  API 33+ (Android 13) themable round launcher icon. Mirrors ic_launcher.xml:
  adds the <monochrome> layer so launchers can recolor it to the user's
  theme/wallpaper color. The shared foreground is already a single-color
  white template, so the launcher tints it as-is.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
