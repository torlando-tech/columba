<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome silhouette for the kotlinBackend flavor's API 33+ themable
  launcher icon: the mesh (same enlarged geometry as ic_notification_stat so
  it reads at themed size) plus the "WIP" wrench badge as a single-color
  template. Android 13+ tints the whole thing to the launcher theme color,
  so the badge loses its amber disc but keeps its wrench-on-ring outline.
-->
