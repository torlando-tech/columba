<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        ReticulumService runs in the :reticulum process so the RNS stack
        survives UI-process OOM kills. Manifest merger pulls this declaration
        into :app at assembly time; :app's own manifest no longer declares
        the service.

        foregroundServiceType=connectedDevice covers BLE / USB peripherals.
        Do NOT add microphone here: FOREGROUND_SERVICE_TYPE_MICROPHONE was
        introduced in API 30 (Android 11). On API 29 the OS silently zeroes
        the entire type mask when it encounters the unknown token, causing
        startForeground(id, n, CONNECTED_DEVICE) to throw IAE (requested
        type 16 not a subset of mask 0) and the service to be killed.
    -->
    <application>
        <service
            android:name="network.columba.app.rns.host.ReticulumService"
            android:enabled="true"
            android:exported="false"
            android:process=":reticulum"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
