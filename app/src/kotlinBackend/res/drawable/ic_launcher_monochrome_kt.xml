            android:fillColor="#FFFFFF" />
    </group>

    <!--
      WIP badge silhouette, moved toward center and shrunk so its outermost
      point stays inside the adaptive-icon safe region (radius ~156 units in
      the 512 viewport; the ring here reaches ~147 from center, inside).
      Same wrench-on-ring mark as ic_launcher_kt_badge, scaled down for the
      monochrome template.
    -->
    <path
        android:pathData="M320,320 m-50,0 a50,50 0,1 1,100 0 a50,50 0,1 1,-100 0"
        android:strokeWidth="12"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="308"
        android:translateY="308">
